PARTPILOT_APP_NAME=Part Pilot
PARTPILOT_ENV=production
# Host interface used for the published Part Pilot port. Keep 0.0.0.0 for the
# current LAN/Nginx Proxy Manager topology; narrow it only after testing routing.
PARTPILOT_BIND_ADDRESS=0.0.0.0
# Immediate reverse-proxy CIDRs trusted to supply forwarded client/origin data.
# Leave empty until the exact proxy path is known and direct-port bypass is blocked.
PARTPILOT_TRUSTED_PROXY_CIDRS=
# Canonical external HTTPS origin for MCP OAuth/discovery when Part Pilot is
# published behind a reverse proxy, for example https://parts.example.com.
PARTPILOT_PUBLIC_BASE_URL=
PARTPILOT_DATABASE_URL=sqlite:///../data/partpilot.db
PARTPILOT_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# Backs Settings -> Data -> Database reset. The route still requires the Primary
# Owner and exact typed confirmation. Set false to disable server-side reset.
PARTPILOT_ENABLE_DEBUG_RESET=true
# Release-image overrides used by docker-compose.release.yml. The source-build
# docker-compose.yml ignores these values.
PARTPILOT_IMAGE=ghcr.io/devanshtangri/part-pilot:v1.0.0
PARTPILOT_DATA_DIR=./data
